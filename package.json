{
  "name": "professional-portfolio",
  "version": "1.0.0",
  "description": "Portfolio and case studies of John Phillip Lacorte — static-first Astro site with a strict CSP, typed content and end-to-end tests.",
  "private": true,
  "type": "module",
  "author": {
    "name": "John Phillip Lacorte",
    "email": "jaypeelacorte28@gmail.com",
    "url": "https://john-phillip-lacorte.vercel.app"
  },
  "homepage": "https://john-phillip-lacorte.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jplacorte/professional-portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/jplacorte/professional-portfolio/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node tools/preview-server.mjs 4321",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run format:check && npm run check && npm test && npm run build",
    "test:e2e": "astro build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "fflate": "^0.8.2"
  },
  "lint-staged": {
    "*.{ts,astro,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,mdx,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
