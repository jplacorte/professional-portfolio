---
import { PRINCIPLES } from '@/data/principles';
---

<section class="container-page mt-32">
  <p class="eyebrow" data-reveal>
    How I work
  </p>
  <div class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
    {PRINCIPLES.map((p, i) => (
      <article
        data-reveal
        style={`--reveal-delay:${i * 90}ms`}
        class="group relative bg-paper p-7 transition-colors duration-500 hover:bg-raised"
      >
        <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-6 text-lg font-semibold tracking-tight">{p.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{p.body}</p>
        <span
          aria-hidden="true"
          class="absolute inset-x-7 bottom-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-700 ease-[var(--ease-out)] group-hover:scale-x-100"
        />
      </article>
    ))}
  </div>
</section>
