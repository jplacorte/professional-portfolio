---
/** Live clock for a time zone (custom element defined in src/scripts/local-time.ts). Renders "—" until JavaScript runs. */
interface Props {
  timeZone: string;
  /** Suffix shown after the time, e.g. "PHT". */
  label: string;
  class?: string;
}
const { timeZone, label, class: className } = Astro.props;
---

<local-time data-tz={timeZone} data-label={label} class={className}>
  —
</local-time>
