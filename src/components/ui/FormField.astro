---
import type { HTMLAttributes } from 'astro/types';

/** Labelled text input or textarea with the site's field styling. Extra attributes pass through. */
type Props = {
  label: string;
  name: string;
  optional?: boolean;
  multiline?: boolean;
} & Omit<HTMLAttributes<'input'> & HTMLAttributes<'textarea'>, 'name' | 'class'>;

const { label, name, optional = false, multiline = false, ...attrs } = Astro.props;
const fieldClass =
  'w-full rounded-lg border border-line-strong bg-raised px-4 py-3 text-ink placeholder:text-muted/70 transition-colors focus:border-ink focus:outline-none';
---

<label class="block space-y-2">
  <span class="text-sm font-medium">
    {label}
    {optional && (
      <>
        {' '}
        <span class="text-muted">(optional)</span>
      </>
    )}
  </span>
  {multiline ? (
    <textarea name={name} class={fieldClass} {...(attrs as HTMLAttributes<'textarea'>)} />
  ) : (
    <input name={name} class={fieldClass} {...(attrs as HTMLAttributes<'input'>)} />
  )}
</label>
