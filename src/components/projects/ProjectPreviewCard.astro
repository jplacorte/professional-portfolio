---
/**
 * Cursor-following preview for ProjectList rows (desktop, fine pointers only).
 * Content and position are driven by scripts/row-preview.ts.
 */
---

<div
  data-preview-card
  aria-hidden="true"
  class="pointer-events-none fixed top-0 left-0 z-50 hidden w-72 opacity-0 transition-opacity duration-300 [@media(pointer:fine)]:block"
  style="--hue: 12"
>
  <div class="overflow-hidden rounded-xl border border-line-strong bg-raised shadow-2xl shadow-black/10">
    <div
      class="relative h-28 overflow-hidden"
      style="background: radial-gradient(120% 90% at 0% 0%, oklch(0.72 0.16 var(--hue) / 0.45), transparent 70%), linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 16px 16px, linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 16px 16px;"
    >
      <p
        data-preview-title
        class="absolute top-3 left-4 right-4 truncate text-lg font-semibold tracking-tight text-ink"
      ></p>
      <div class="absolute inset-x-4 bottom-3 flex gap-1.5">
        <span class="h-1.5 w-8 rounded-full" style="background: oklch(0.68 0.17 var(--hue));"></span>
        <span class="h-1.5 w-4 rounded-full bg-line-strong"></span>
        <span class="h-1.5 w-12 rounded-full bg-line-strong"></span>
      </div>
    </div>
    <div class="space-y-2 p-4">
      <p data-preview-label class="text-sm leading-snug text-ink-soft"></p>
      <p data-preview-stack class="font-mono text-[0.7rem] text-muted"></p>
    </div>
  </div>
</div>
