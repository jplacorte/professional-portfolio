---
import ProjectPreviewCard from '@/components/projects/ProjectPreviewCard.astro';
import { statusLabel, type Project } from '@/lib/projects';

interface Props {
  projects: Project[];
  /** Show row numbers (01, 02…). */
  numbered?: boolean;
}
const { projects, numbered = true } = Astro.props;
/** Accent hue per row for the hover preview card (OKLCH hue angles). */
const PREVIEW_HUES = [12, 210, 150, 280, 35, 190];
---

<ol class="border-t border-line" data-preview-list>
  {projects.map((p, i) => {
    const href = p.data.caseStudy ? `/projects/${p.id}` : undefined;
    const Row = href ? 'a' : 'div';
    return (
      <li data-reveal class="border-b border-line">
        <Row
          href={href}
          data-preview={p.data.summary}
          data-preview-title={p.data.title}
          data-preview-stack={p.data.stack.slice(0, 4).join(' · ')}
          data-preview-hue={PREVIEW_HUES[i % PREVIEW_HUES.length]}
          class:list={[
            'group relative grid grid-cols-[auto_1fr_auto] items-baseline gap-x-4 gap-y-1 py-6 sm:grid-cols-[3rem_1fr_auto_auto] sm:gap-x-6',
            href && 'cursor-pointer',
          ]}
        >
          {/* hover wash */}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 origin-bottom scale-y-0 bg-raised transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-y-100"
          />
          <span class="font-mono text-xs text-muted">{numbered ? String(i + 1).padStart(2, '0') : ''}</span>
          <span class="min-w-0">
            <span
              class="block text-xl font-medium tracking-tight transition-transform duration-500 ease-[var(--ease-out)] group-hover:translate-x-2 sm:text-2xl"
              style={`view-transition-name: title-${p.id}`}
            >
              {p.data.title}
              {p.data.draft && (
                <span class="ml-2 rounded bg-accent-soft px-1.5 py-0.5 align-middle font-mono text-[0.65rem] text-accent">
                  DRAFT
                </span>
              )}
            </span>
            <span class="mt-1 block text-sm text-muted sm:hidden">{p.data.summary}</span>
          </span>
          <span class="hidden font-mono text-xs text-muted sm:block">{p.data.stack.slice(0, 3).join(' / ')}</span>
          <span class="flex items-center gap-3 font-mono text-xs text-muted">
            <span class="hidden sm:inline">{statusLabel[p.data.status]}</span>
            <span>{p.data.year}</span>
            {href && (
              <svg
                viewBox="0 0 16 16"
                class="size-4 -translate-x-1 opacity-0 transition-all duration-500 ease-[var(--ease-out)] group-hover:translate-x-0 group-hover:text-accent group-hover:opacity-100"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            )}
          </span>
        </Row>
      </li>
    );
  })}
</ol>

<ProjectPreviewCard />
