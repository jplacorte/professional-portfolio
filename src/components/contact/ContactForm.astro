---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import TextArea from '@/components/ui/TextArea.astro';
import TextField from '@/components/ui/TextField.astro';

/**
 * Posts to /api/contact. Works without JavaScript (the API redirects back with ?sent / ?error);
 * with JavaScript it submits via fetch and shows the result inline (src/scripts/contact-form.ts).
 */
---

<form
  method="post"
  action="/api/contact"
  data-contact-form
  class="fade-in-late space-y-5"
  style="--delay:350ms"
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <TextField label="Name" name="name" required maxlength={100} autocomplete="name" />
    <TextField label="Email" name="email" type="email" required maxlength={200} autocomplete="email" />
  </div>
  <TextField label="Company" name="company" optional maxlength={120} autocomplete="organization" />
  <TextArea label="Message" name="message" required minlength={10} maxlength={5000} rows={6} />

  <!-- Honeypot: hidden from people, tempting to bots. -->
  <div aria-hidden="true" class="absolute -left-[9999px]">
    <label>
      Website <input name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  {PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-theme="auto" />}

  <div class="flex items-center gap-4">
    <button
      type="submit"
      data-magnetic="0.25"
      class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper disabled:opacity-60"
    >
      <span
        aria-hidden="true"
        class="absolute inset-0 translate-y-full rounded-full bg-accent transition-transform duration-500 ease-[var(--ease-out)] group-hover:translate-y-0"
      ></span>
      <span class="relative transition-colors group-hover:text-accent-ink" data-label>
        Send message
      </span>
    </button>
    <p data-status role="status" aria-live="polite" class="text-sm"></p>
  </div>
</form>

{PUBLIC_TURNSTILE_SITE_KEY && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
)}
