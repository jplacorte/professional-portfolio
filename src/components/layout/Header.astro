---
import { NAV, SITE } from '@/config/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-40 border-b border-transparent bg-paper/75 backdrop-blur-md transition-colors [&.is-scrolled]:border-line"
  data-header
  style="view-transition-name: site-header"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5 font-medium tracking-tight">
      <span
        class="grid size-7 place-items-center rounded-md bg-ink font-mono text-[0.7rem] font-semibold text-paper transition-transform duration-500 ease-[var(--ease-out)] group-hover:rotate-[-8deg]"
        aria-hidden="true"
      >
        JL
      </span>
      <span class="sr-only sm:not-sr-only">{SITE.shortName}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 text-sm">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="rounded-full px-3 py-1.5 text-muted transition-colors hover:text-ink aria-[current=page]:bg-ink aria-[current=page]:text-paper"
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="ml-1">
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>
