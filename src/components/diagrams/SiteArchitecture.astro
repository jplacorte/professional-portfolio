---
import ArchitectureDiagram, { type DiagramEdge, type DiagramNode } from './ArchitectureDiagram.astro';

const nodes: DiagramNode[] = [
  { id: 'repo', x: 20, y: 40, w: 200, label: 'GitHub repo', sub: 'MDX content + code' },
  { id: 'ci', x: 20, y: 170, w: 200, label: 'GitHub Actions', sub: 'check · build · Lighthouse' },
  { id: 'cdn', x: 290, y: 105, w: 180, label: 'Vercel edge / CDN', sub: 'pre-rendered HTML', accent: true },
  { id: 'visitor', x: 570, y: 40, w: 150, label: 'Visitor', sub: 'browser' },
  { id: 'fn', x: 570, y: 170, w: 150, label: '/api/contact', sub: 'serverless function' },
  { id: 'ext', x: 570, y: 290, w: 150, label: 'Turnstile + Resend', sub: 'spam check · email' },
];

const edges: DiagramEdge[] = [
  { from: 'repo', to: 'ci' },
  { from: 'ci', to: 'cdn' },
  { from: 'cdn', to: 'visitor' },
  { from: 'visitor', to: 'fn' },
  { from: 'fn', to: 'ext' },
];
---

<ArchitectureDiagram
  id="site-arch"
  width={740}
  height={360}
  {nodes}
  {edges}
  title="Architecture: content in a GitHub repo is checked and built by GitHub Actions, deployed as static HTML to Vercel's edge. Visitors load pages from the edge; the contact form posts to a serverless function that verifies Turnstile and sends email with Resend."
  caption="Fig. 1 — Static-first: only the contact form runs server-side."
/>
